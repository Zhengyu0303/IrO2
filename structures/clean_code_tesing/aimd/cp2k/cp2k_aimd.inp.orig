&GLOBAL
  PROJECT_NAME IrO2_water_aimd
  RUN_TYPE MD
  PRINT_LEVEL LOW
  WALLTIME 84600    ! 23h30m safety margin under 24h SLURM limit, writes restart before kill
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
      NGRIDS 5
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 30
      SCF_GUESS RESTART
      ADDED_MOS 100
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBUFFER 8
      &END MIXING
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.37796914 12.85806618 32.14504372
      PERIODIC XYZ
    &END CELL
